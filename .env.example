# The SEC's fair-access policy requires every request to sec.gov to carry a
# User-Agent that names the application and a contact address they can reach
# you at. Requests without one are rejected with 403.
#
# This is a real contact channel: if the app ever misbehaves against their
# servers, the SEC contacts this address rather than silently banning the IP.
# Use an address you're willing to have attached to outbound traffic — a role
# or alias address is a reasonable choice for a deployed app.
#
# Never commit the filled-in value. Set it locally in .env.local, and in the
# Vercel dashboard under Settings > Environment Variables for deploys.
#
# Format: "AppName contact@example.com"
SEC_USER_AGENT="Fund Analyzer you@example.com"


# --- Supabase (Canadian ETF holdings store) --------------------------------
#
# Only needed to run `npm run ingest`. The app works without these.
# Find them in the Supabase dashboard under Project Settings -> API Keys.

SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Publishable ("anon") key — read-only under RLS, safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service-role key — bypasses RLS and grants full write access. Used only by
# scripts/ingest.ts. Never commit it, never send it to the browser, and prefer
# a secrets store over a file if you later run ingestion in CI.
SUPABASE_SERVICE_ROLE_KEY=""
