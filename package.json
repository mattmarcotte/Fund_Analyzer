    "recharts": "2.15.4",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.2"
  },
